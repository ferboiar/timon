{
    "name": "Timon",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            },
            "extensions": [
                "esbenp.prettier-vscode",
                "dbaeumer.vscode-eslint",
                "ms-azuretools.vscode-docker",
                "ms-vscode.remote-explorer"
            ]
        }
    },
    "postCreateCommand": "npm install && (cd e2e && npm ci) && git config core.hooksPath scripts/hooks && for f in backend/.env backend/src/db/.db_connection backend/src/db/.db_connection.backup e2e/.env; do [ -f \"$f\" ] && chmod 600 \"$f\"; done",
    "remoteUser": "node",
    "forwardPorts": [3000, 5173],
    "portsAttributes": {
        "3000": {
            "label": "Backend"
        },
        "5173": {
            "label": "Frontend"
        }
    }
}