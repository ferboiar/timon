# Variables de entorno de la suite E2E de Timón.
#
# Copia este fichero a `.env` (chmod 600) y rellena los valores en tu equipo.
# Aquí solo van NOMBRES de variables: nunca valores reales.
#
# El portátil puede exportar E2E_CDP_URL y E2E_BASE_URL en el entorno antes de
# ejecutar: dotenv (18.x) no sobrescribe variables ya definidas, así que las del
# entorno tienen prioridad sobre las del fichero.

# --- Obligatorias ---
# Endpoint CDP del Edge que conduce la suite (Edge con --remote-debugging-port).
E2E_CDP_URL=
# URL de la aplicación tal y como la ve ese Edge.
E2E_BASE_URL=
# Usuario de la base de datos de desarrollo con el que se ejecutan los tests.
E2E_USER=
# Contraseña de ese usuario.
E2E_PASSWORD=

# --- Opcionales ---
# Directorio de ejecución (artefactos, logs, estado, temporales).
# E2E_RUNTIME_DIR=/tmp/timon-e2e
# Bases de datos permitidas, separadas por comas. Si la base configurada en
# backend/src/db/.db_connection no está en la lista, la suite aborta.
# E2E_BASES_PERMITIDAS=conta_hogar
# Arrancar front y back si no están vivos (1) o exigir que ya lo estén (0).
# E2E_ARRANCAR_SERVIDORES=1
# Maximizar la ventana de Edge usada por la suite (1) o no (0).
# E2E_MAXIMIZAR_VENTANA=1
# Borrar categorías huérfanas de ejecuciones anteriores (1, por defecto) o solo
# informar (0). Solo afecta a nombres con el formato exacto e2e_categoria_AAAAMMDD_HHMMSS.
# E2E_LIMPIAR_HUERFANAS=1
